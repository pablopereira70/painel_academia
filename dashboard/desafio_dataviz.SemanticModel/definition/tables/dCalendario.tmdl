	column 'Dia da semana num'
		formatString: 0
		lineageTag: 11824a49-80ef-43c2-8213-6a323874f805
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Dia da semana num]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source =
				
				var dataMin = if(min(fCheckins[data]) < min(fPagamentos[data]), min(fCheckins[data]), min(fPagamentos[data]))
				var dataMax = if(max(fCheckins[data]) > max(fPagamentos[data]), max(fCheckins[data]), max(fPagamentos[data]))
				return ADDCOLUMNS(CALENDAR(dataMin, dataMax),
				"Ano", year([Date]),
				"Mes num", MONTH([Date]),
				"Mes abrev", format([Date], "MMM"),
				"Dia", day([Date]),
				"Dia da semana", format([Date], "ddd"),
				"Dia da semana num", SWITCH(true,
				format([Date], "ddd")= "seg", 1,
				format([Date], "ddd") = "ter", 2,
				format([Date], "ddd") = "qua", 3,
				format([Date], "ddd")= "qui", 4,
				format([Date], "ddd") = "sex", 5,
				format([Date], "ddd") = "sáb", 6,
				7))

	annotation PBI_Id = 59318c271cb145169e1378c10b96bbe2

