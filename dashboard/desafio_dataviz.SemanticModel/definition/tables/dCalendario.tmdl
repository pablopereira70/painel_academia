table dCalendario
	lineageTag: 8548ef51-f036-45a0-8b08-5464b6d015b2

	column Date
		formatString: General Date
		lineageTag: a664e609-87ed-4e95-ae22-88eb5a7d551a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variação
			isDefault
			relationship: f719b611-d1a0-4083-a915-15c6bec4cebb
			defaultHierarchy: LocalDateTable_87a9804b-9d6c-4e6c-b586-fe8191e518cc.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column Ano
		formatString: 0
		lineageTag: f1142114-f448-4f94-8a11-2bce8970debf
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	column 'Mes num'
		formatString: 0
		lineageTag: 202a6f27-b978-4471-8ac2-9b8a9c7f395c
		summarizeBy: sum
